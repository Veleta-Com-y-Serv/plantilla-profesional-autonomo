---
// Contacto: a la izquierda titular, `texto`, datos de site.yaml → contacto con iconos e `imagen` opcional (3:2);
// a la derecha, formulario (mailto) con desplegable de servicios (títulos de secciones.servicios.items).
// `boton` opcional: texto del botón de enviar.
import { seccion, site, tel, whatsapp, mapa, cadena } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
import FormularioContacto from '../ui/FormularioContacto.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const c = site.contacto;
const servicios = (site.secciones.servicios?.activa ? site.secciones.servicios.items : []).map((i) => cadena(i.titulo)).filter(Boolean);
const boton = cadena(s?.boton) || undefined;
---

{
  s && (
    <Seccion id={Astro.props.id}>
      <div class="grid gap-12 md:grid-cols-12 md:gap-10">
        <div class="md:col-span-5">
          <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} class="mb-8" />
          <ul class="datos-contacto">
            {c.telefono && (
              <li>
                <Icono nombre="telefono" class="mt-0.5 shrink-0 text-primario" tam={20} />
                <a href={tel(c.telefono)}><span class="sr-only">Teléfono: </span>{c.telefono}</a>
              </li>
            )}
            {c.whatsapp && (
              <li>
                <Icono nombre="whatsapp" class="mt-0.5 shrink-0 text-primario" tam={20} />
                <a href={whatsapp(c.whatsapp)} rel="noopener" target="_blank"><span class="sr-only">WhatsApp: </span>{c.whatsapp}</a>
              </li>
            )}
            {c.email && (
              <li>
                <Icono nombre="correo" class="mt-0.5 shrink-0 text-primario" tam={20} />
                <a class="break-all" href={`mailto:${c.email}`}><span class="sr-only">Email: </span>{c.email}</a>
              </li>
            )}
            {c.direccion && (
              <li>
                <Icono nombre="mapa" class="mt-0.5 shrink-0 text-primario" tam={20} />
                <a href={mapa(c.direccion)} rel="noopener" target="_blank"><span class="sr-only">Dirección: </span>{c.direccion}</a>
              </li>
            )}
            {c.horario && (
              <li>
                <Icono nombre="reloj" class="mt-0.5 shrink-0 text-primario" tam={20} />
                <span><span class="sr-only">Horario: </span>{c.horario}</span>
              </li>
            )}
          </ul>
          {s.imagen && <Imagen src={s.imagen} alt="" ancho={900} alto={600} class="mt-8 aspect-[3/2] w-full rounded-md object-cover" />}
        </div>
        <div class="md:col-span-7 lg:col-span-6 lg:col-start-7">
          <div class="tarjeta-form">
            <FormularioContacto servicios={servicios} boton={boton} />
          </div>
        </div>
      </div>
    </Seccion>
  )
}
